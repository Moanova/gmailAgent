# gmailAgent — template des variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Le fichier .env est ignoré par git (ne jamais le committer).

# Clé API Mistral (obligatoire) — https://console.mistral.ai/
MISTRAL_API_KEY=

# Niveau de journalisation (optionnel, défaut : INFO)
# Valeurs : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Chemin du fichier de journalisation (optionnel)
# LOG_FILE=logs/gmailagent.log
